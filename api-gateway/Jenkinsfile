pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID     = '853149252707'
        AWS_REGION         = 'ap-south-1'
        ECR_REGISTRY       = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        SERVICE_NAME       = 'api-gateway'
        ECR_REPO           = "${ECR_REGISTRY}/bidauc/${SERVICE_NAME}"
        IMAGE_TAG          = "main-${GIT_COMMIT[0..6]}"
        AWS_CREDENTIALS_ID = 'aws-bidauc-jenkins'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Guard: Changed Files') {
            steps {
                script {
                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD || echo 'initial'",
                        returnStdout: true
                    ).trim()

                    echo "Changed files:\n${changedFiles}"

                    def relevant = changedFiles.split('\n').any { file ->
                        file.startsWith("api-gateway/")
                    }

                    if (!relevant) {
                        currentBuild.result = 'NOT_BUILT'
                        echo "No changes in api-gateway. Skipping pipeline."
                        error("SKIP: No relevant changes detected.")
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch: ${env.GIT_BRANCH}"
                echo "Commit: ${env.GIT_COMMIT}"
                echo "Image tag: ${env.IMAGE_TAG}"
            }
        }

        // No Lint/Unit Test stage — api-gateway is a config-only image.
        // Validation happens via nginx's own startup check (fail-fast on
        // invalid config) plus the Docker healthcheck in compose/K8s.
        // This is intentional, not an oversight: there is no application
        // logic here to lint or unit test, only a reverse-proxy config.

        stage('Build Docker Image') {
            steps {
                dir("${SERVICE_NAME}") {
                    script {
                        echo "Building Docker image: ${ECR_REPO}:${IMAGE_TAG}"
                        sh """
                            docker build \
                                -f ./Dockerfile \
                                -t ${ECR_REPO}:${IMAGE_TAG} \
                                -t ${ECR_REPO}:latest \
                                --no-cache \
                                .
                        """
                    }
                }
            }
        }

        stage('Smoke Test Container') {
            steps {
                script {
                    echo "Starting container to verify nginx boots cleanly..."
                    sh """
                        CONTAINER_ID=\$(docker run -d ${ECR_REPO}:${IMAGE_TAG})
                        sleep 3

                        # nginx fails fast on invalid config — if the container
                        # is not running after 3s, the config is broken
                        STATUS=\$(docker inspect -f '{{.State.Running}}' \$CONTAINER_ID)

                        if [ "\$STATUS" != "true" ]; then
                            echo "Container exited unexpectedly. Dumping logs:"
                            docker logs \$CONTAINER_ID
                            docker rm -f \$CONTAINER_ID || true
                            error("nginx failed to start — invalid config in image.")
                        fi

                        echo "Container running cleanly. nginx started successfully."
                        docker rm -f \$CONTAINER_ID
                    """
                }
            }
        }

        stage('Push to ECR') {
            steps {
                script {
                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS_ID}",
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]]) {
                        sh """
                            aws ecr get-login-password \
                                --region ${AWS_REGION} | \
                            docker login \
                                --username AWS \
                                --password-stdin ${ECR_REGISTRY}

                            docker push ${ECR_REPO}:${IMAGE_TAG}
                            docker push ${ECR_REPO}:latest

                            echo "Pushed: ${ECR_REPO}:${IMAGE_TAG}"
                        """
                    }
                }
            }
        }

        stage('Cleanup') {
            steps {
                sh """
                    docker rmi ${ECR_REPO}:${IMAGE_TAG} || true
                    docker rmi ${ECR_REPO}:latest || true
                    echo "Local images cleaned up."
                """
            }
        }
    }

    post {
        success {
            echo """
            ✅ Pipeline SUCCESS
            Service:  ${SERVICE_NAME}
            Image:    ${ECR_REPO}:${IMAGE_TAG}
            Commit:   ${GIT_COMMIT}
            """
        }
        failure {
            echo """
            ❌ Pipeline FAILED
            Service: ${SERVICE_NAME}
            Branch:  ${GIT_BRANCH}
            Commit:  ${GIT_COMMIT}
            Check logs above for root cause.
            """
        }
        always {
            cleanWs()
        }
    }
}